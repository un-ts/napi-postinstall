{
  "extends": "@1stg/tsconfig/node",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "types": ["node", "web"],
    "paths": {
      "napi-postinstall": ["./src/index.ts"],
      "napi-postinstall/fallback": ["./src/fallback.ts"]
    },
    "target": "ES2020"
  }
}
