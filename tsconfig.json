{
  "extends": "@1stg/tsconfig/node16",
  "compilerOptions": {
    "importHelpers": false,
    "rootDir": ".",
    "types": ["node", "web"],
    "paths": {
      "napi-postinstall": ["./src/index.ts"],
      "napi-postinstall/cli": ["./src/cli.ts"],
      "napi-postinstall/fallback": ["./src/fallback.ts"]
